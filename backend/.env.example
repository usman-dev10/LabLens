# Paste your Groq API key after the equals sign. Do not commit backend/.env.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=
MODEL_SUPPORTS_FILES=false
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_PATH=lablens.db
